# ── API ───────────────────────────────────────────────────────────────────────
# URL of the NestJS API (no trailing slash)
EXPO_PUBLIC_API_URL=https://your-api.railway.app

# ── Stripe ────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── Push Notifications ────────────────────────────────────────────────────────
# Must match VAPID_PUBLIC_KEY set in the API service
EXPO_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
