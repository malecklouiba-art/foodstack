{
  "expo": {
    "name": "Foodstack Driver",
    "slug": "foodstack-driver",
    "version": "1.0.0",
    "scheme": "foodstack-driver",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#16a34a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "art.malecklouiba.foodstack.driver",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Votre position est utilisée pour les livraisons.",
        "NSLocationAlwaysUsageDescription": "Votre position est utilisée en arrière-plan pendant les livraisons."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16a34a"
      },
      "package": "art.malecklouiba.foodstack.driver",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-location"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
