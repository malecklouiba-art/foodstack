# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production
# URL of the deployed web app — used for CORS allow-list
FRONTEND_URL=https://your-app.vercel.app

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/foodstack
REDIS_URL=redis://user:password@host:6379

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-32-char-random-secret
JWT_REFRESH_SECRET=replace-with-another-32-char-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com

# ── SMS (Twilio) — optional, SMS notifications disabled if unset ──────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15550000000

# ── Push Notifications (Web Push / VAPID) ────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Must be a mailto: or https: URI
VAPID_SUBJECT=mailto:admin@yourdomain.com
